<%- include('partials/header') %>
<h2>내 정보</h2>
<% if (message) { %><p class="error"><%= message %></p><% } %>
<% if (me.school_id) { %>
<div class="card">
  <h3>학년과 반</h3>
  <p class="muted"><%= me.school_name %> · 시간표를 보려면 입력해 주세요.</p>
  <form method="post" action="/me/class">
    <label>학년<select name="grade">
      <% [1, 2, 3].forEach(g => { %><option value="<%= g %>" <%= me.grade === g ? 'selected' : '' %>><%= g %>학년</option><% }) %>
    </select></label>
    <label>반<input name="class_nm" value="<%= me.class_nm || '' %>" maxlength="5" placeholder="예: 3" required></label>
    <button>저장</button>
  </form>
</div>
<% } %>
<div class="card">
  <h3>내가 쓴 글</h3>
  <ul class="list">
    <% posts.forEach(p => { %>
      <li><a href="/post/<%= p.id %>"><%= p.title %></a>
        <div class="muted"><%= p.school_id ? me.school_name : '전체 게시판' %> · <%= p.created_at.toLocaleString('ko-KR', { timeZone: 'Asia/Seoul' }) %></div></li>
    <% }) %>
    <% if (!posts.length) { %><li class="muted">아직 쓴 글이 없어요.</li><% } %>
  </ul>
</div>
<div class="card">
  <h3>내가 쓴 댓글</h3>
  <ul class="list">
    <% comments.forEach(c => { %>
      <li><a href="/post/<%= c.post_id %>"><%= c.body %></a>
        <div class="muted"><%= c.title %> · <%= c.created_at.toLocaleString('ko-KR', { timeZone: 'Asia/Seoul' }) %></div></li>
    <% }) %>
    <% if (!comments.length) { %><li class="muted">아직 쓴 댓글이 없어요.</li><% } %>
  </ul>
</div>
<%- include('partials/footer') %>
