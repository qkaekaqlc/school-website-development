<%- include('partials/header') %>
<p><a href="/board/<%= post.scope %>">← 목록</a></p>
<div class="card">
  <h2><%= post.title %></h2>
  <p class="muted">익명 · <%= post.created_at.toLocaleString('ko-KR', { timeZone: 'Asia/Seoul' }) %></p>
  <pre><%= post.body %></pre>
  <p>
    <% if (post.mine || me.is_admin) { %>
      <form class="inline" method="post" action="/post/<%= post.id %>/delete" onsubmit="return confirm('삭제할까요?')"><button class="plain">삭제</button></form>
    <% } %>
    <% if (!post.mine) { %>
      <form class="inline" method="post" action="/report/post/<%= post.id %>" onsubmit="this.reason.value = prompt('신고 사유') || ''; return !!this.reason.value">
        <input type="hidden" name="reason"><button class="plain">신고</button></form>
    <% } %>
  </p>
</div>
<div class="card">
  <ul class="list">
    <% comments.forEach(c => { %>
      <li>
        <b><%= c.label %></b> <span class="muted"><%= c.created_at.toLocaleString('ko-KR', { timeZone: 'Asia/Seoul' }) %></span>
        <% if (c.body === null) { %><p class="muted">삭제된 댓글이에요.</p><% } else { %>
          <pre><%= c.body %></pre>
          <% if (c.mine || me.is_admin) { %>
            <form class="inline" method="post" action="/comment/<%= c.id %>/delete"><button class="plain">삭제</button></form>
          <% } %>
          <% if (!c.mine) { %>
            <form class="inline" method="post" action="/report/comment/<%= c.id %>" onsubmit="this.reason.value = prompt('신고 사유') || ''; return !!this.reason.value">
              <input type="hidden" name="reason"><button class="plain">신고</button></form>
          <% } %>
        <% } %>
      </li>
    <% }) %>
  </ul>
  <form method="post" action="/post/<%= post.id %>/comment">
    <textarea name="body" rows="3" maxlength="1000" placeholder="익명으로 댓글 달기" required></textarea>
    <button>댓글</button>
  </form>
</div>
<%- include('partials/footer') %>
