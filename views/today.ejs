<%- include('partials/header') %>
<h2><%= date %> · <%= me.school_name %></h2>
<% if (error) { %><div class="card"><p class="error"><%= error %></p></div><% } else { %>
<div class="card">
  <h3>급식</h3>
  <% if (!meals.length) { %><p class="muted">오늘은 급식 정보가 없어요.</p><% } %>
  <% meals.forEach(m => { %>
    <p><b><%= m.type %></b><br><%= m.dishes.join(', ') %></p>
  <% }) %>
</div>
<div class="card">
  <h3>시간표<% if (me.grade) { %> · <%= me.grade %>학년 <%= me.class_nm %>반<% } %></h3>
  <% if (!timetable) { %><p class="muted"><a href="/me">내 정보</a>에서 학년과 반을 입력하면 시간표가 보여요.</p>
  <% } else if (!timetable.length) { %><p class="muted">오늘은 시간표 정보가 없어요.</p>
  <% } else { %>
    <ul class="list"><% timetable.forEach(t => { %><li><b><%= t.period %>교시</b> <%= t.subject %></li><% }) %></ul>
  <% } %>
</div>
<% } %>
<%- include('partials/footer') %>
